# --- Required ---

# Public Supabase URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key (Project Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Shared admin passcode for /admin route
ADMIN_PASSCODE=change-me-now

# Secret used to sign the "I voted" cookie. Generate with: openssl rand -hex 32
BALLOT_COOKIE_SECRET=change-this-to-a-random-32-byte-hex-string

# --- Optional ---

# Microlink API key for higher rate limits. Free tier works without a key.
# https://microlink.io/docs/api/getting-started/overview
MICROLINK_API_KEY=

# Optional: a self-hosted GitLab base URL (no trailing slash) for repo previews.
# Public gitlab.com is auto-detected; set this if teams submit URLs on a private GitLab.
GITLAB_HOST=

# Display date in the footer
NEXT_PUBLIC_EVENT_DATE="December 2026"

# Default voting close time (ISO 8601). Admin can override at runtime.
NEXT_PUBLIC_DEFAULT_VOTING_CLOSE=2026-12-31T23:59:00-08:00
